<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070709">

    <!-- 1. Idle / Pairing Screen -->
    <LinearLayout
        android:id="@+id/idleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="40dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="18:45"
                android:textColor="#F4F4F6"
                android:textSize="76sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Q1 Cinema • Готов к запуску"
                android:textColor="#E50914"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:text="Отсканируй QR-код камерой телефона или открой адрес в браузере (в одной Wi-Fi сети):"
                android:textColor="#9A9AA6"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ipUrlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#15161E"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="http://192.168.1.x:8080"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Пульт не нужен — всё управление со смартфона"
                android:textColor="#5E5E6E"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp">

            <ImageView
                android:id="@+id/qrImageView"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:contentDescription="QR Code"
                android:scaleType="fitCenter" />
        </FrameLayout>

    </LinearLayout>

    <!-- 2. Native Hardware ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 3. Ad-Blocking WebView for Cinema Sites / YouTube / VK -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 4. HTML5 Video Fullscreen Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- 5. Top Status Toast Overlay -->
    <TextView
        android:id="@+id/overlayToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="#CC14151D"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
